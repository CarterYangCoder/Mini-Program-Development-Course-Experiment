page { background: #F3F5F9; }
.page { min-height: 100vh; padding: 30rpx 32rpx 60rpx; box-sizing: border-box; }
.profile-card { padding: 34rpx; border-radius: 32rpx; color: #fff; background: linear-gradient(135deg,#516FEA,#7658E9); box-shadow: 0 16rpx 36rpx rgba(77,91,210,.28); }
.profile-main { display: flex; align-items: center; }
.profile-main image { width: 92rpx; height: 92rpx; margin-right: 20rpx; border: 4rpx solid rgba(255,255,255,.65); border-radius: 50%; background: #fff; }
.name { font-size: 31rpx; font-weight: 700; }
.sub { margin-top: 8rpx; color: rgba(255,255,255,.68); font-size: 21rpx; }
.stats { margin-top: 32rpx; padding-top: 26rpx; display: flex; border-top: 1rpx solid rgba(255,255,255,.16); }
.stat { flex: 1; text-align: center; color: rgba(255,255,255,.66); font-size: 19rpx; }
.stat text { display: block; margin-bottom: 6rpx; color: #fff; font-size: 34rpx; font-weight: 700; }
.section-title { margin: 36rpx 4rpx 20rpx; color: #2E3442; font-size: 30rpx; font-weight: 700; }
.section-title text { margin-left: 10rpx; color: #A0A8B7; font-size: 20rpx; font-weight: 400; }
.record { margin-bottom: 16rpx; padding: 22rpx; display: flex; align-items: center; border-radius: 24rpx; background: #fff; box-shadow: 0 6rpx 18rpx rgba(31,45,61,.05); }
.level-badge { width: 66rpx; height: 66rpx; border-radius: 20rpx; color: #fff; background: linear-gradient(145deg,#718CFF,#526FEA); font-size: 28rpx; font-weight: 700; line-height: 66rpx; text-align: center; }
.record-copy { flex: 1; margin-left: 18rpx; }
.record-title { color: #303644; font-size: 25rpx; font-weight: 700; }
.record-title text { margin-left: 10rpx; padding: 4rpx 9rpx; border-radius: 8rpx; color: #E88A31; background: #FFF1DF; font-size: 16rpx; }
.record-time { margin-top: 7rpx; color: #A0A8B6; font-size: 19rpx; }
.steps { margin-right: 18rpx; color: #929BAA; font-size: 19rpx; }
.steps text { color: #4A6CF7; font-size: 28rpx; font-weight: 700; }
.again { padding: 11rpx 15rpx; border-radius: 13rpx; color: #5B72D7; background: #EEF2FF; font-size: 19rpx; }
.again-hover { transform: scale(.95); opacity: .8; }
.empty { margin-top: 80rpx; text-align: center; }
.empty image { width: 130rpx; height: 130rpx; opacity: .5; filter: grayscale(.2); }
.empty-title { margin-top: 22rpx; color: #5C6574; font-size: 28rpx; font-weight: 700; }
.empty-sub { margin-top: 10rpx; color: #A1A9B6; font-size: 21rpx; }
