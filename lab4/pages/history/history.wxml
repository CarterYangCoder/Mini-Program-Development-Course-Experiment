<view class='page'>
  <view class='profile-card'>
    <view class='profile-main'>
      <image src='{{user.avatarUrl}}' mode='aspectFill'></image>
      <view>
        <view class='name'>{{user.nickname}} 的游戏档案</view>
        <view class='sub'>每一次通关都值得被记住</view>
      </view>
    </view>
    <view class='stats'>
      <view class='stat'><text>{{totalGames}}</text><view>完成对局</view></view>
      <view class='stat'><text>{{bestCount}}</text><view>刷新最佳</view></view>
      <view class='stat'><text>{{totalSteps}}</text><view>累计步数</view></view>
    </view>
  </view>

  <view class='section-title'>最近对局 <text>{{totalGames}} 场</text></view>

  <view class='empty' wx:if='{{records.length === 0}}'>
    <image src='/images/icons/box.png' mode='aspectFit'></image>
    <view class='empty-title'>还没有游戏记录</view>
    <view class='empty-sub'>完成任意关卡后，对局就会出现在这里</view>
  </view>

  <view class='record-list' wx:else>
    <view class='record' wx:for='{{records}}' wx:key='id'>
      <view class='level-badge'>{{item.level}}</view>
      <view class='record-copy'>
        <view class='record-title'>第 {{item.level}} 关 <text wx:if='{{item.isNewBest}}'>新纪录</text></view>
        <view class='record-time'>{{item.time}}</view>
      </view>
      <view class='steps'><text>{{item.steps}}</text> 步</view>
      <view class='again' hover-class='again-hover' data-level='{{item.level}}' bindtap='playAgain'>再来</view>
    </view>
  </view>
</view>
