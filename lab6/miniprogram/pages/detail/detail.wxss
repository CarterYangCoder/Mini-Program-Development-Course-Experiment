.detail-page {
  min-height: 100vh;
  background: #ffffff;
  color: #202124;
}

.detail-state {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 70vh;
  color: #858b96;
  font-size: 28rpx;
}

.loading-ring {
  width: 30rpx;
  height: 30rpx;
  margin-right: 16rpx;
  border: 4rpx solid #ffe0c9;
  border-top-color: #ff7a1a;
  border-radius: 50%;
  animation: loading-rotate 0.9s linear infinite;
}

@keyframes loading-rotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.empty-state {
  flex-direction: column;
}

.state-title {
  color: #202124;
  font-size: 30rpx;
  font-weight: 600;
}

.state-copy {
  margin-top: 12rpx;
  font-size: 24rpx;
}

.photo-stage {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 360rpx;
  overflow: hidden;
  background: #17181a;
  font-size: 0;
  line-height: 0;
}

.detail-photo {
  display: block;
  width: 100%;
  height: auto;
}

.preview-hint {
  position: absolute;
  right: 24rpx;
  bottom: 20rpx;
  height: 48rpx;
  padding: 0 18rpx;
  border-radius: 24rpx;
  background: rgba(0, 0, 0, 0.5);
  color: rgba(255, 255, 255, 0.9);
  font-size: 22rpx;
  line-height: 48rpx;
}

.detail-content {
  padding: 34rpx 32rpx 10rpx;
}

.topic-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.topic-tag {
  display: inline-flex;
  align-items: center;
  height: 52rpx;
  padding: 0 20rpx;
  border-radius: 26rpx;
  background: #fff3ea;
  color: #e86200;
  font-size: 24rpx;
  font-weight: 600;
}

.publish-date {
  color: #9ca1aa;
  font-size: 22rpx;
}

.detail-title {
  display: block;
  margin-top: 24rpx;
  color: #202124;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 60rpx;
}

.detail-description {
  display: block;
  margin-top: 20rpx;
  color: #50565f;
  font-size: 29rpx;
  line-height: 48rpx;
  white-space: pre-wrap;
}

.detail-description-empty {
  color: #a0a5ad;
}

.author-card {
  display: flex;
  align-items: center;
  min-height: 124rpx;
  margin-top: 34rpx;
  padding: 16rpx 0;
  border-top: 1rpx solid #eceef2;
}

.author-avatar {
  flex-shrink: 0;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #f0f1f3;
}

.author-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  margin-left: 18rpx;
}

.author-name {
  overflow: hidden;
  color: #202124;
  font-size: 28rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.author-note {
  margin-top: 5rpx;
  color: #9298a1;
  font-size: 22rpx;
}

.follow-button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 128rpx;
  height: 88rpx;
  border: 1rpx solid #ff7a1a;
  border-radius: 44rpx;
  color: #e86200;
  font-size: 24rpx;
  font-weight: 600;
}

.followed-button {
  border-color: #e1e3e7;
  background: #f5f6f8;
  color: #858b96;
}

.card-hover,
.action-hover {
  opacity: 0.72;
}

.detail-bottom-space {
  height: calc(142rpx + env(safe-area-inset-bottom));
}

.detail-actions {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  display: flex;
  align-items: flex-start;
  height: calc(112rpx + env(safe-area-inset-bottom));
  padding: 6rpx 18rpx env(safe-area-inset-bottom);
  border-top: 1rpx solid #eceef2;
  background: rgba(255, 255, 255, 0.98);
}

.detail-action {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  flex-direction: column;
  height: 100rpx;
  margin: 0;
  padding: 0;
  border-radius: 16rpx;
  background: transparent;
  color: #858b96;
  font-size: 22rpx;
  line-height: 1.2;
}

.detail-action::after {
  border: 0;
}

.detail-action image {
  width: 40rpx;
  height: 40rpx;
  margin-bottom: 7rpx;
}

.detail-action-active {
  color: #e86200;
}

.detail-action-danger {
  color: #cf4a3c;
}
