.page-shell {
  min-height: 100vh;
  background: #f5f6f8;
  color: #202124;
}

.feed-header {
  position: sticky;
  top: 0;
  z-index: 8;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 104rpx;
  padding: 0 24rpx;
  border-bottom: 1rpx solid #eceef2;
  background: rgba(255, 255, 255, 0.98);
}

.header-side,
.publish-entry {
  width: 132rpx;
}

.feed-tabs {
  display: flex;
  align-items: stretch;
  justify-content: center;
  height: 100%;
}

.feed-tab {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 112rpx;
  min-height: 88rpx;
  color: #858b96;
  font-size: 30rpx;
  font-weight: 500;
}

.feed-tab-active {
  color: #202124;
  font-weight: 700;
}

.feed-tab-active::after {
  position: absolute;
  bottom: 10rpx;
  left: 50%;
  width: 36rpx;
  height: 6rpx;
  margin-left: -18rpx;
  border-radius: 6rpx;
  background: #ff7a1a;
  content: "";
}

.publish-entry {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  min-height: 88rpx;
  color: #ff7a1a;
  font-size: 28rpx;
  font-weight: 600;
}

.publish-entry-icon,
.floating-plus {
  position: relative;
  width: 30rpx;
  height: 30rpx;
}

.publish-entry-icon {
  margin-right: 8rpx;
  border: 2rpx solid #ff7a1a;
  border-radius: 10rpx;
}

.publish-entry-icon::before,
.publish-entry-icon::after,
.floating-plus::before,
.floating-plus::after {
  position: absolute;
  top: 50%;
  left: 50%;
  border-radius: 4rpx;
  content: "";
  transform: translate(-50%, -50%);
}

.publish-entry-icon::before {
  width: 16rpx;
  height: 2rpx;
  background: #ff7a1a;
}

.publish-entry-icon::after {
  width: 2rpx;
  height: 16rpx;
  background: #ff7a1a;
}

.search-panel {
  display: flex;
  align-items: center;
  height: 88rpx;
  margin: 20rpx 24rpx 12rpx;
  padding: 0 28rpx;
  border: 1rpx solid #f0f1f3;
  border-radius: 32rpx;
  background: #f3f4f6;
}

.search-icon {
  position: relative;
  flex-shrink: 0;
  width: 28rpx;
  height: 28rpx;
  margin-right: 20rpx;
  border: 3rpx solid #858b96;
  border-radius: 50%;
}

.search-icon::after {
  position: absolute;
  right: -10rpx;
  bottom: -7rpx;
  width: 14rpx;
  height: 3rpx;
  border-radius: 3rpx;
  background: #858b96;
  content: "";
  transform: rotate(45deg);
  transform-origin: left center;
}

.search-input {
  flex: 1;
  height: 84rpx;
  color: #202124;
  font-size: 28rpx;
}

.search-placeholder,
.nickname-placeholder {
  color: #a4a9b2;
}

.tag-scroll {
  width: 100%;
  height: 92rpx;
  border-bottom: 1rpx solid #eceef2;
  background: #ffffff;
  white-space: nowrap;
}

.tag-list {
  display: inline-flex;
  align-items: center;
  height: 92rpx;
  padding: 0 24rpx;
}

.tag-item {
  position: relative;
  display: inline-flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  min-width: 88rpx;
  height: 88rpx;
  margin-right: 28rpx;
  padding: 0 4rpx;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: #5f6670;
  font-size: 26rpx;
}

.tag-item-active {
  color: #e86200;
  font-weight: 600;
}

.tag-item-active::after {
  position: absolute;
  bottom: 4rpx;
  left: 50%;
  width: 32rpx;
  height: 4rpx;
  margin-left: -16rpx;
  border-radius: 4rpx;
  background: #ff7a1a;
  content: "";
}

.tag-hover,
.tap-hover,
.nav-hover,
.action-hover {
  opacity: 0.72;
}

.login-strip {
  display: flex;
  align-items: center;
  min-height: 120rpx;
  margin: 8rpx 24rpx 20rpx;
  padding: 12rpx 16rpx 12rpx 12rpx;
  border: 1rpx solid #eceef2;
  border-radius: 20rpx;
  background: #ffffff;
}

.login-button::after,
.action-button::after,
.floating-publish::after {
  border: 0;
}

.login-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #f0f1f3;
}

.login-content {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  margin: 0 18rpx;
}

.login-hint {
  overflow: hidden;
  color: #5f6670;
  font-size: 24rpx;
  line-height: 34rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.login-subtitle {
  width: 100%;
  margin-top: 4rpx;
  color: #9a9fa8;
  font-size: 22rpx;
}

.login-button {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 136rpx;
  min-width: 136rpx;
  max-width: 136rpx;
  height: 88rpx;
  margin: 0;
  padding: 0 24rpx;
  border-radius: 32rpx;
  background: #ff7a1a;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 88rpx;
}

.button-hover,
.floating-hover {
  background: #e86200;
}

.state-block {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 340rpx;
  margin: 8rpx 24rpx 24rpx;
  border-radius: 24rpx;
  background: #ffffff;
  color: #858b96;
  font-size: 28rpx;
}

.loading-ring {
  width: 28rpx;
  height: 28rpx;
  margin-right: 16rpx;
  border: 4rpx solid #ffe0c9;
  border-top-color: #ff7a1a;
  border-radius: 50%;
  animation: loading-rotate 0.9s linear infinite;
}

@keyframes loading-rotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.empty-state {
  flex-direction: column;
}

.empty-picture {
  position: relative;
  width: 92rpx;
  height: 72rpx;
  margin-bottom: 24rpx;
  border: 4rpx solid #c5c9d0;
  border-radius: 16rpx;
}

.empty-picture::before {
  position: absolute;
  top: 14rpx;
  right: 14rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #ff7a1a;
  content: "";
}

.empty-picture::after {
  position: absolute;
  bottom: 10rpx;
  left: 18rpx;
  width: 40rpx;
  height: 40rpx;
  border-top: 4rpx solid #d1d5db;
  border-left: 4rpx solid #d1d5db;
  content: "";
  transform: rotate(45deg);
}

.state-title {
  color: #5f6670;
  font-size: 28rpx;
  font-weight: 600;
}

.state-note {
  margin-top: 10rpx;
  color: #a0a5ae;
  font-size: 24rpx;
}

.feed-list {
  padding: 4rpx 24rpx 0;
}

.feed-card {
  overflow: hidden;
  margin-bottom: 20rpx;
  border: 0;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 10rpx rgba(32, 33, 36, 0.025);
}

.card-author-row {
  min-height: 112rpx;
  padding: 16rpx 24rpx 8rpx;
}

.author-link {
  display: flex;
  align-items: center;
  min-height: 88rpx;
}

.author-avatar {
  flex-shrink: 0;
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: #f0f1f3;
}

.author-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  margin-left: 18rpx;
}

.author-name {
  overflow: hidden;
  color: #202124;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 40rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.author-meta {
  display: flex;
  align-items: center;
  margin-top: 4rpx;
  color: #858b96;
  font-size: 22rpx;
  line-height: 32rpx;
}

.meta-dot {
  margin: 0 10rpx;
}

.category-label {
  color: #e86200;
}

.work-copy {
  display: block;
  padding: 4rpx 24rpx 22rpx;
}

.work-title {
  display: block;
  color: #202124;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 48rpx;
}

.work-description {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 10rpx;
  color: #5f6670;
  font-size: 28rpx;
  line-height: 42rpx;
  word-break: break-all;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
}

.photo-link {
  display: block;
  min-height: 220rpx;
  background: #f0f1f3;
  font-size: 0;
  line-height: 0;
}

.photo-hover {
  opacity: 0.94;
}

.work-image {
  display: block;
  width: 100%;
  height: auto;
  background: #f0f1f3;
}

.card-actions {
  display: flex;
  align-items: center;
  justify-content: space-around;
  min-height: 96rpx;
  padding: 0 12rpx;
  border-top: 1rpx solid #eceef2;
}

.action-button {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  min-width: 0;
  height: 88rpx;
  margin: 0;
  padding: 0 12rpx;
  border-radius: 16rpx;
  background: transparent;
  color: #858b96;
  font-size: 24rpx;
  line-height: 1;
}

.action-icon {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  margin-right: 10rpx;
}

.action-count {
  margin-left: 8rpx;
}

.action-button-active {
  color: #e86200;
}

.bottom-safe-space {
  height: calc(152rpx + env(safe-area-inset-bottom));
}

.bottom-nav {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  display: flex;
  align-items: flex-start;
  justify-content: space-around;
  height: calc(116rpx + env(safe-area-inset-bottom));
  padding: 8rpx 52rpx env(safe-area-inset-bottom);
  border-top: 1rpx solid #eceef2;
  background: rgba(255, 255, 255, 0.98);
}

.nav-item,
.nav-center-space {
  width: 160rpx;
  height: 100rpx;
}

.nav-item {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  color: #858b96;
  font-size: 22rpx;
}

.nav-icon {
  width: 44rpx;
  height: 44rpx;
  margin-bottom: 4rpx;
}

.nav-item-active {
  color: #ff7a1a;
  font-weight: 600;
}

.floating-publish {
  position: fixed;
  bottom: calc(50rpx + env(safe-area-inset-bottom));
  left: 50%;
  z-index: 24;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  min-width: 96rpx;
  max-width: 96rpx;
  height: 96rpx;
  min-height: 96rpx;
  max-height: 96rpx;
  margin: 0 0 0 -48rpx;
  padding: 0;
  border: 8rpx solid #ffffff;
  border-radius: 50%;
  background: #ff7a1a;
  box-shadow: 0 8rpx 22rpx rgba(255, 122, 26, 0.2);
}

.floating-plus::before {
  width: 30rpx;
  height: 4rpx;
  background: #ffffff;
}

.floating-plus::after {
  width: 4rpx;
  height: 30rpx;
  background: #ffffff;
}

.profile-setup-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 99;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.45);
}

.profile-setup-dialog {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 600rpx;
  padding: 48rpx 48rpx 40rpx;
  border-radius: 24rpx;
  background: #ffffff;
}

.profile-setup-title {
  color: #202124;
  font-size: 34rpx;
  font-weight: 700;
}

.profile-setup-subtitle {
  margin-top: 12rpx;
  color: #858b96;
  font-size: 26rpx;
}

.profile-setup-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 144rpx;
  height: 144rpx;
  margin-top: 36rpx;
  padding: 0;
  border-radius: 50%;
  background: #f3f4f6;
  overflow: hidden;
}

.profile-setup-avatar::after {
  border: none;
}

.profile-setup-avatar-image {
  width: 144rpx;
  height: 144rpx;
  border-radius: 50%;
}

.profile-setup-avatar-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.profile-setup-avatar-icon {
  width: 56rpx;
  height: 56rpx;
  opacity: 0.5;
}

.profile-setup-avatar-hint {
  margin-top: 6rpx;
  color: #a4a9b2;
  font-size: 20rpx;
}

.profile-setup-input {
  width: 100%;
  height: 88rpx;
  margin-top: 32rpx;
  padding: 0 28rpx;
  border-radius: 16rpx;
  background: #f3f4f6;
  color: #202124;
  font-size: 28rpx;
  box-sizing: border-box;
}

.profile-setup-actions {
  display: flex;
  justify-content: space-between;
  width: 100%;
  margin-top: 40rpx;
}

.profile-setup-cancel,
.profile-setup-confirm {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 240rpx;
  height: 84rpx;
  margin: 0;
  padding: 0;
  border-radius: 42rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.profile-setup-cancel::after,
.profile-setup-confirm::after {
  border: none;
}

.profile-setup-cancel {
  background: #f3f4f6;
  color: #555a64;
}

.profile-setup-confirm {
  background: #ff7a1a;
  color: #ffffff;
}
