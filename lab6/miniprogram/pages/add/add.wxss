.publish-page {
  min-height: 100vh;
  padding: 30rpx 24rpx 0;
  background: #f5f6f8;
  color: #202124;
}

.page-intro {
  display: flex;
  flex-direction: column;
  padding: 12rpx 4rpx 34rpx;
}

.intro-eyebrow {
  color: #ff7a1a;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.intro-title {
  margin-top: 12rpx;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 58rpx;
}

.intro-copy {
  margin-top: 8rpx;
  color: #858b96;
  font-size: 26rpx;
}

.section-head {
  display: flex;
  align-items: center;
  min-height: 72rpx;
}

.section-index {
  margin-right: 14rpx;
  color: #ff7a1a;
  font-size: 22rpx;
  font-weight: 700;
}

.section-title {
  color: #202124;
  font-size: 30rpx;
  font-weight: 700;
}

.section-note {
  margin-left: auto;
  color: #9da2ab;
  font-size: 22rpx;
}

.image-picker {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  width: 100%;
  height: 460rpx;
  border: 2rpx dashed #d9dde3;
  border-radius: 24rpx;
  background: #ffffff;
}

.image-picker-selected {
  border-style: solid;
  border-color: #202124;
  background: #17181a;
}

.picker-hover {
  opacity: 0.9;
}

.selected-image {
  width: 100%;
  height: 100%;
}

.picker-empty {
  display: flex;
  align-items: center;
  flex-direction: column;
  padding: 40rpx;
}

.picker-icon {
  position: relative;
  width: 92rpx;
  height: 72rpx;
  border: 3rpx solid #858b96;
  border-radius: 16rpx;
}

.picker-icon::before {
  position: absolute;
  top: 14rpx;
  right: 16rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #ff7a1a;
  content: "";
}

.picker-icon::after {
  position: absolute;
  bottom: 10rpx;
  left: 20rpx;
  width: 36rpx;
  height: 36rpx;
  border-top: 4rpx solid #b4b9c1;
  border-left: 4rpx solid #b4b9c1;
  content: "";
  transform: rotate(45deg);
}

.picker-title {
  margin-top: 28rpx;
  color: #202124;
  font-size: 30rpx;
  font-weight: 600;
}

.picker-copy {
  margin-top: 10rpx;
  color: #858b96;
  font-size: 22rpx;
  text-align: center;
}

.image-tools {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  min-height: 88rpx;
}

.tool-action {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 112rpx;
  height: 88rpx;
  margin-left: 12rpx;
  color: #5f6670;
  font-size: 24rpx;
}

.tool-danger {
  color: #cf4a3c;
}

.form-head {
  margin-top: 12rpx;
}

.form-card {
  overflow: hidden;
  padding: 0 28rpx;
  border: 1rpx solid #eceef2;
  border-radius: 24rpx;
  background: #ffffff;
}

.field-block {
  padding: 26rpx 0;
  border-bottom: 1rpx solid #eceef2;
}

.field-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.field-label {
  color: #202124;
  font-size: 28rpx;
  font-weight: 600;
}

.field-count {
  color: #a4a9b2;
  font-size: 22rpx;
}

.title-input {
  width: 100%;
  height: 74rpx;
  margin-top: 8rpx;
  color: #202124;
  font-size: 30rpx;
}

.description-input {
  width: 100%;
  height: 220rpx;
  margin-top: 20rpx;
  color: #202124;
  font-size: 28rpx;
  line-height: 44rpx;
}

.field-placeholder {
  color: #afb3ba;
}

.category-field {
  border-bottom: 0;
}

.category-list {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

.category {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 112rpx;
  height: 88rpx;
  margin: 0 14rpx 14rpx 0;
  padding: 0 22rpx;
  border: 1rpx solid #e3e5e9;
  border-radius: 36rpx;
  background: #f7f8f9;
  color: #5f6670;
  font-size: 24rpx;
}

.category-active {
  border-color: #ff7a1a;
  background: #fff4ec;
  color: #e86200;
  font-weight: 600;
}

.category-hover {
  opacity: 0.75;
}

.publish-feedback {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #ffffff;
}

.feedback-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  margin-right: 18rpx;
  border-radius: 50%;
  font-size: 28rpx;
  font-weight: 700;
}

.feedback-success .feedback-mark {
  background: #eef8f0;
  color: #38854a;
}

.feedback-error .feedback-mark {
  background: #fff0ee;
  color: #cf4a3c;
}

.feedback-title,
.feedback-copy {
  display: block;
}

.feedback-title {
  color: #202124;
  font-size: 26rpx;
  font-weight: 600;
}

.feedback-copy {
  margin-top: 4rpx;
  color: #858b96;
  font-size: 22rpx;
}

.publish-bottom-space {
  height: calc(164rpx + env(safe-area-inset-bottom));
}

.publish-footer {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 10;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #eceef2;
  background: rgba(255, 255, 255, 0.98);
}

.publish-main {
  width: 100%;
  height: 92rpx;
  margin: 0;
  padding: 0;
  border-radius: 24rpx;
  background: #ff7a1a;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 92rpx;
}

.publish-main::after {
  border: 0;
}

.publish-main[disabled] {
  background: #e5e7ea;
  color: #9da2aa;
}

.publish-hover {
  background: #e86200;
}
