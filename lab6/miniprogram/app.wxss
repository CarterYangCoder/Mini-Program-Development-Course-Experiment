page {
  min-height: 100%;
  background: #f5f6f8;
  color: #202124;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

view,
text,
image,
navigator,
scroll-view,
input,
textarea,
button {
  box-sizing: border-box;
}

.container {
  width: 100%;
  min-height: 100vh;
}
