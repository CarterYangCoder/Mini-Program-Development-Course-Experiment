.search-page { min-height: 100vh; background: #f5f6f8; }

.search-header { position: relative; overflow: hidden; display: flex; align-items: center; gap: 20rpx; padding: 20rpx 24rpx; background: #d71920; }
.search-header .search-bar, .search-header .search-header__cancel { position: relative; z-index: 1; }
.search-bar { display: flex; flex: 1; align-items: center; height: 72rpx; padding: 0 22rpx; border-radius: 36rpx; background: #ffffff; }
.search-bar__icon { margin-right: 12rpx; color: #a0a7b1; font-size: 38rpx; line-height: 1; transform: rotate(-18deg); }
.search-bar__input { flex: 1; height: 72rpx; color: #20242c; font-size: 28rpx; }
.search-bar__placeholder { color: #a0a7b1; }
.search-bar__clear { flex: none; width: 44rpx; height: 44rpx; border-radius: 50%; background: #eceef1; color: #7b8794; font-size: 30rpx; line-height: 44rpx; text-align: center; }
.search-header__cancel { flex: none; color: #ffffff; font-size: 28rpx; }

.result-meta { padding: 26rpx 28rpx 6rpx; color: #9299a3; font-size: 24rpx; }
.result-meta__count { color: #d71920; font-weight: 700; }

.result-list { margin: 18rpx 24rpx 32rpx; overflow: hidden; border-radius: 16rpx; background: #ffffff; box-shadow: 0 7rpx 24rpx rgba(16, 24, 40, 0.05); }
.result-card { display: flex; min-height: 172rpx; margin: 0 24rpx; padding: 24rpx 0; border-bottom: 1rpx solid #eceff2; }
.result-card:last-child { border-bottom: 0; }
.result-card__body { display: flex; flex: 1; min-width: 0; flex-direction: column; padding-right: 22rpx; }
.result-card__category { align-self: flex-start; margin-bottom: 10rpx; color: #d71920; font-size: 21rpx; font-weight: 700; }
.result-card__title { display: -webkit-box; overflow: hidden; color: #20242c; font-family: SimSun, "Songti SC", serif; font-size: 30rpx; font-weight: 600; line-height: 1.5; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.result-card__footer { display: flex; gap: 16rpx; margin-top: auto; color: #a0a6ae; font-size: 21rpx; }
.result-card__image { flex: none; width: 200rpx; height: 136rpx; border-radius: 10rpx; background: #e9edf1; }

.history-panel { margin: 24rpx; padding: 28rpx; border-radius: 16rpx; background: #ffffff; box-shadow: 0 7rpx 24rpx rgba(16, 24, 40, 0.05); }
.history-panel__heading { display: flex; align-items: center; justify-content: space-between; }
.history-panel__title { color: #20242c; font-size: 28rpx; font-weight: 700; }
.history-panel__clear { color: #a0a7b1; font-size: 24rpx; }
.history-panel__tags { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 22rpx; }
.history-tag { padding: 10rpx 26rpx; border-radius: 999rpx; background: #f2f3f5; color: #4a5568; font-size: 25rpx; }

.search-empty { padding: 140rpx 60rpx; text-align: center; }
.search-empty__icon { width: 110rpx; height: 110rpx; margin: 0 auto 30rpx; border-radius: 50%; background: #fdecec; color: #d71920; font-size: 56rpx; line-height: 110rpx; }
.search-empty__title { color: #2b313b; font-size: 30rpx; font-weight: 600; }
.search-empty__hint { margin-top: 14rpx; color: #9299a3; font-size: 24rpx; line-height: 1.7; }
