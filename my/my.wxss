.mine-page {
  min-height: 100vh;
  background: #f5f6f8;
  color: #20242c;
}

.mine-header {
  position: relative;
  padding: 34rpx 30rpx 72rpx;
  background: linear-gradient(150deg, #a90f1a 0%, #d92328 56%, #ef4438 100%);
  color: #ffffff;
}

.mine-header::before,
.mine-header::after {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.07);
  content: "";
  pointer-events: none;
}

.mine-header::before {
  top: -170rpx;
  right: -110rpx;
  width: 430rpx;
  height: 430rpx;
}

.mine-header::after {
  top: 110rpx;
  right: 150rpx;
  width: 130rpx;
  height: 130rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  background: transparent;
}

.user-row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  min-height: 176rpx;
  padding: 18rpx 4rpx 34rpx;
}

.user-avatar {
  flex: none;
  width: 116rpx;
  height: 116rpx;
  border: 6rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 12rpx 30rpx rgba(91, 0, 8, 0.22);
}

.user-avatar--placeholder {
  color: #bc1720;
  font-family: SimSun, "Songti SC", serif;
  font-size: 50rpx;
  font-weight: 700;
  line-height: 104rpx;
  text-align: center;
}

.user-info {
  flex: 1;
  min-width: 0;
  margin-left: 25rpx;
}

.user-name {
  overflow: hidden;
  font-size: 35rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-hint {
  margin-top: 11rpx;
  color: rgba(255, 255, 255, 0.76);
  font-size: 22rpx;
  line-height: 1.45;
}

.user-action {
  flex: none;
  width: 112rpx;
  margin: 0 0 0 16rpx;
  padding: 0;
  border: 0;
  border-radius: 30rpx;
  background: #ffffff;
  color: #b9141e;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 60rpx;
  box-shadow: 0 8rpx 20rpx rgba(83, 0, 8, 0.15);
}

.user-action::after {
  border: 0;
}

.user-action--logout {
  border: 1rpx solid rgba(255, 255, 255, 0.46);
  background: rgba(255, 255, 255, 0.12);
  color: #ffffff;
  box-shadow: none;
  font-weight: 400;
}

.quick-stats {
  position: relative;
  z-index: 2;
  display: flex;
  margin: 0 0 -126rpx;
  padding: 25rpx 8rpx 23rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.85);
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 16rpx 38rpx rgba(65, 24, 28, 0.13);
  color: #262a31;
}

.quick-stat {
  position: relative;
  flex: 1;
  min-width: 0;
  text-align: center;
}

.quick-stat + .quick-stat::before {
  position: absolute;
  top: 8rpx;
  bottom: 8rpx;
  left: 0;
  width: 1rpx;
  background: #eceef1;
  content: "";
}

.quick-stat__number {
  color: #b71720;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.15;
}

.quick-stat__label {
  margin-top: 8rpx;
  color: #7b828c;
  font-size: 20rpx;
  white-space: nowrap;
}

.mine-content {
  padding: 78rpx 22rpx 52rpx;
}

.study-banner {
  position: relative;
  min-height: 208rpx;
  padding: 32rpx;
  overflow: hidden;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #79121c 0%, #ad1922 52%, #d5392f 100%);
  color: #ffffff;
  box-shadow: 0 14rpx 32rpx rgba(132, 23, 30, 0.2);
}

.study-banner::before,
.study-banner::after {
  position: absolute;
  border-radius: 50%;
  content: "";
  pointer-events: none;
}

.study-banner::before {
  right: -112rpx;
  bottom: -148rpx;
  width: 410rpx;
  height: 300rpx;
  border: 30rpx solid rgba(255, 217, 161, 0.13);
}

.study-banner::after {
  top: -82rpx;
  right: 38rpx;
  width: 180rpx;
  height: 180rpx;
  background: rgba(255, 255, 255, 0.055);
}

.study-banner__eyebrow {
  position: relative;
  z-index: 1;
  color: #f6d49a;
  font-size: 21rpx;
  font-weight: 600;
  letter-spacing: 6rpx;
}

.study-banner__title {
  position: relative;
  z-index: 1;
  margin-top: 15rpx;
  font-family: SimSun, "Songti SC", serif;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.45;
}

.study-banner__subtitle {
  position: relative;
  z-index: 1;
  width: 72%;
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 21rpx;
  line-height: 1.55;
}

.study-banner__button {
  position: absolute;
  right: 25rpx;
  bottom: 25rpx;
  z-index: 1;
  padding: 10rpx 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.42);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.08);
  color: rgba(255, 255, 255, 0.92);
  font-size: 21rpx;
}

.panel {
  margin-top: 22rpx;
  padding: 31rpx 28rpx;
  border: 1rpx solid #eceef1;
  border-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(28, 35, 46, 0.045);
}

.panel-heading--row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.panel-heading__title {
  color: #20242c;
  font-size: 31rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.panel-heading__subtitle {
  margin-top: 7rpx;
  color: #969da7;
  font-size: 21rpx;
}

.service-grid {
  display: flex;
  margin-top: 32rpx;
}

.service-item {
  flex: 1;
  min-width: 0;
  text-align: center;
}

.service-item__icon {
  width: 76rpx;
  height: 76rpx;
  margin: 0 auto;
  border-radius: 23rpx;
  color: #ffffff;
  font-family: SimSun, "Songti SC", serif;
  font-size: 31rpx;
  font-weight: 700;
  line-height: 76rpx;
  box-shadow: 0 9rpx 20rpx rgba(36, 41, 49, 0.13);
}

.service-item__icon--red {
  background: linear-gradient(145deg, #c51b24, #e64d46);
}

.service-item__icon--blue {
  background: linear-gradient(145deg, #315f91, #5c8fbe);
}

.service-item__icon--cyan {
  background: linear-gradient(145deg, #357f86, #64a9aa);
}

.service-item__icon--gold {
  background: linear-gradient(145deg, #a97835, #d1a25b);
}

.service-item__title {
  margin-top: 14rpx;
  overflow: hidden;
  color: #30343b;
  font-size: 23rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.service-item__subtitle {
  margin-top: 4rpx;
  color: #a2a8b0;
  font-size: 18rpx;
  white-space: nowrap;
}

.reading-panel {
  display: flex;
  align-items: center;
  border-color: #eee7e6;
  background: linear-gradient(100deg, #fffafa 0%, #ffffff 72%);
}

.reading-mark {
  flex: none;
  width: 82rpx;
  height: 82rpx;
  border-radius: 23rpx;
  background: #fcebea;
  color: #b71921;
  font-family: SimSun, "Songti SC", serif;
  font-size: 37rpx;
  font-weight: 700;
  line-height: 82rpx;
  text-align: center;
}

.reading-copy {
  flex: 1;
  min-width: 0;
  margin-left: 21rpx;
}

.reading-copy__title {
  color: #262b33;
  font-size: 28rpx;
  font-weight: 700;
}

.reading-copy__subtitle {
  margin-top: 7rpx;
  color: #969da6;
  font-size: 21rpx;
}

.reading-button {
  flex: none;
  padding: 11rpx 20rpx;
  border: 1rpx solid #e8b8b7;
  border-radius: 28rpx;
  background: #ffffff;
  color: #b71921;
  font-size: 22rpx;
}

.favorite-count {
  min-width: 54rpx;
  height: 54rpx;
  padding: 0 15rpx;
  border-radius: 27rpx;
  background: #fceceb;
  color: #b71921;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 54rpx;
  text-align: center;
}

.favorite-item {
  display: flex;
  align-items: center;
  padding: 25rpx 0;
  border-bottom: 1rpx solid #edf0f2;
}

.favorite-item:last-child {
  border-bottom: 0;
}

.favorite-item__image {
  flex: none;
  width: 168rpx;
  height: 112rpx;
  border-radius: 12rpx;
  background: #edf0f2;
}

.favorite-item__body {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.favorite-item__title {
  display: -webkit-box;
  overflow: hidden;
  color: #252a32;
  font-family: SimSun, "Songti SC", serif;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1.5;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.favorite-item__date {
  margin-top: 10rpx;
  color: #9ea4ac;
  font-size: 20rpx;
}

.favorite-item__arrow {
  margin-left: 13rpx;
  color: #c2c6cc;
  font-size: 38rpx;
}

.empty-box {
  margin-top: 24rpx;
  padding: 48rpx 20rpx 40rpx;
  border-radius: 18rpx;
  background: #fafafb;
  text-align: center;
}

.empty-box__icon {
  color: #cd4447;
  font-size: 64rpx;
  line-height: 1;
}

.empty-box__title {
  margin-top: 18rpx;
  color: #3b4048;
  font-size: 27rpx;
  font-weight: 600;
}

.empty-box__hint {
  margin-top: 9rpx;
  color: #9da3ac;
  font-size: 21rpx;
}

.empty-box__button {
  display: inline-block;
  margin-top: 25rpx;
  padding: 12rpx 25rpx;
  border-radius: 28rpx;
  background: #f9e7e6;
  color: #b71921;
  font-size: 22rpx;
}

.empty-box__login {
  width: 220rpx;
  margin-top: 25rpx;
  border: 0;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #ad1620, #d93232);
  color: #ffffff;
  font-size: 24rpx;
  line-height: 64rpx;
  box-shadow: 0 9rpx 20rpx rgba(177, 23, 31, 0.16);
}

.empty-box__login::after {
  border: 0;
}

.user-edit {
  margin-left: 8rpx;
  color: rgba(255, 255, 255, 0.75);
  font-size: 24rpx;
}

.sheet-mask {
  position: fixed;
  inset: 0;
  z-index: 999;
  display: flex;
  align-items: flex-end;
  background: rgba(15, 18, 24, 0.45);
  animation: mask-in 0.25s ease both;
}

.profile-sheet {
  width: 100%;
  padding: 16rpx 40rpx 60rpx;
  padding-bottom: calc(60rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
  border-radius: 32rpx 32rpx 0 0;
  background: #ffffff;
  text-align: center;
  animation: sheet-up 0.3s ease both;
}

.profile-sheet__handle {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 26rpx;
  border-radius: 4rpx;
  background: #e3e6ea;
}

.profile-sheet__title {
  color: #1d222b;
  font-size: 32rpx;
  font-weight: 700;
}

.profile-sheet__subtitle {
  margin-top: 10rpx;
  color: #a1a7af;
  font-size: 22rpx;
}

.profile-sheet__avatar-btn {
  margin: 34rpx auto 0;
  padding: 0;
  border: 0;
  background: transparent;
  line-height: 1.4;
}

.profile-sheet__avatar-btn::after {
  border: 0;
}

.profile-sheet__avatar {
  width: 150rpx;
  height: 150rpx;
  border: 5rpx solid #fdecec;
  border-radius: 50%;
  background: #f2f3f5;
  box-shadow: 0 8rpx 22rpx rgba(16, 24, 40, 0.12);
}

.profile-sheet__avatar-tip {
  margin-top: 14rpx;
  color: #b71921;
  font-size: 22rpx;
}

.profile-sheet__input {
  height: 84rpx;
  margin-top: 30rpx;
  padding: 0 28rpx;
  border: 1rpx solid #eceff2;
  border-radius: 16rpx;
  background: #f7f8fa;
  color: #20242c;
  font-size: 28rpx;
  text-align: center;
}

.profile-sheet__placeholder {
  color: #a0a7b1;
}

.profile-sheet__actions {
  display: flex;
  gap: 20rpx;
  margin-top: 36rpx;
}

.profile-sheet__cancel {
  flex: 1;
  border-radius: 999rpx;
  background: #f2f3f5;
  color: #6b7280;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 80rpx;
}

.profile-sheet__confirm {
  flex: 2;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ad1620, #d93232);
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 80rpx;
  box-shadow: 0 8rpx 20rpx rgba(177, 22, 32, 0.22);
}

@keyframes mask-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes sheet-up {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.about-line {
  padding: 38rpx 10rpx 12rpx;
  color: #9ea4ac;
  font-size: 21rpx;
  text-align: center;
}

.about-line__version {
  margin-top: 8rpx;
  color: #b4b9c0;
  font-size: 19rpx;
}

@media (max-width: 360px) {
  .mine-header {
    padding-right: 22rpx;
    padding-left: 22rpx;
  }

  .mine-content {
    padding-right: 16rpx;
    padding-left: 16rpx;
  }

  .user-avatar {
    width: 104rpx;
    height: 104rpx;
  }

  .user-avatar--placeholder {
    line-height: 92rpx;
  }

  .user-action {
    width: 96rpx;
  }

  .service-item__icon {
    width: 66rpx;
    height: 66rpx;
    line-height: 66rpx;
  }

  .service-item__subtitle {
    display: none;
  }
}
