<view class="tab-bar" wx:if="{{visible}}">
  <view class="tab-bar__inner">
    <view class="tab-item {{selected === index ? 'tab-item--active' : ''}}" wx:for="{{list}}" wx:key="path" data-path="{{item.path}}" data-index="{{index}}" bindtap="switchTab">
      <view class="tab-item__pill">
        <view class="tab-item__icon">{{item.icon}}</view>
        <view class="tab-item__text">{{item.text}}</view>
      </view>
    </view>
  </view>
</view>
